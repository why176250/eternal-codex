# Battle.net API credentials for the English enrichment pipeline.
# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — never commit real credentials.
BLIZZARD_CLIENT_ID=your_client_id
BLIZZARD_CLIENT_SECRET=your_client_secret
BLIZZARD_REGION=us

# Public site URL (set after the domain is live)
NEXT_PUBLIC_SITE_URL=https://eversixty.com

# Search Console verification (optional, set in Vercel env)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
